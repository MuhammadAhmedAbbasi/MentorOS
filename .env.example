# MentorOS — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────
# Docker Compose publishes Postgres on host port 5433 (see docker-compose.yml).
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://mentoros:mentoros@localhost:5433/mentoros
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── LLM Provider ─────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | anthropic
LLM_MODEL=qwen3.5:9b         # model name for the chosen provider
LLM_TIMEOUT_SECONDS=60       # per-call timeout
LLM_MAX_RETRIES=2

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (used in v0.2 for pgvector semantic memory — model pulled via Ollama)
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024

# Anthropic (when LLM_PROVIDER=anthropic — leave blank for ollama)
ANTHROPIC_API_KEY=

# ── Stub Auth ────────────────────────────────────────────────
# In v0.1 the student ID is taken from this header name.
STUDENT_ID_HEADER=X-Student-Id

# ── Assessment ───────────────────────────────────────────────
SYMPY_TIMEOUT_SECONDS=5      # per-expression SymPy evaluation timeout
